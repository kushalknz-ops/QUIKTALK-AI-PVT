-  );
-  rimStrip.position.set(25, 0, 10);
-  rimStrip.rotation.y = Math.PI / 2.5;
-  envScene.add(rimStrip);
-
-  const renderTarget = pmremGenerator.fromScene(envScene);
-  pmremGenerator.dispose();
-  return renderTarget.texture;
-};
