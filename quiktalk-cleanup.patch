-// Navigation helper with precise header offset handling for fixed navbar
-function scrollToSec(id) {
-  const el = document.getElementById(id);
-  if (el) {
-    // If the element has a .sec-head inside it, target the heading so it sits cleanly below the navbar
-    const targetNode = (id === 'process') ? el : (el.querySelector('.sec-head') || el);
-    const navHeight = 74; // Navbar height
-    const paddingOffset = (id === 'process') ? 120 : 24; // 24px padding under navbar for section heads
-    const targetTop = targetNode.getBoundingClientRect().top + window.pageYOffset - navHeight - paddingOffset;
-    window.scrollTo({ top: Math.max(0, targetTop), behavior: 'smooth' });
-  }
-}
