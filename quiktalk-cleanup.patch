-// HIGH-CONTRAST STUDIO ENVIRONMENT MAP (Exact Match to Logo Mirror Chrome)
-const generateChromeEnvMap = (renderer) => {
-  const pmremGenerator = new THREE.PMREMGenerator(renderer);
-  pmremGenerator.compileEquirectangularShader();
-
-  const envScene = new THREE.Scene();
-  envScene.background = new THREE.Color(0x020204);
-
-  // Softbox Top White Highlight Box
-  const topLight = new THREE.Mesh(
-    new THREE.PlaneGeometry(60, 30),
-    new THREE.MeshBasicMaterial({ color: 0xffffff, side: THREE.DoubleSide })
-  );
-  topLight.position.set(0, 25, 5);
