-// Procedural Microphone Mesh Texture (Realistic Perforated Metal Grille / Cross-Hatch Net)
-const createMicNetTexture = () => {
-  const canvas = document.createElement('canvas');
-  canvas.width = 512;
-  canvas.height = 512;
-  const ctx = canvas.getContext('2d');
-
-  // Deep matte black base
-  ctx.fillStyle = '#060608';
-  ctx.fillRect(0, 0, 512, 512);
-
-  // Cross-hatch wire mesh weave
-  ctx.lineWidth = 3;
-  const step = 16;
-
-  ctx.strokeStyle = '#282834';
-  for (let x = -512; x < 1024; x += step) {
-    ctx.beginPath();
-    ctx.moveTo(x, 0);
-    ctx.lineTo(x + 512, 512);
-    ctx.stroke();
-  }
-
-  ctx.strokeStyle = '#1e1e28';
-  for (let x = -512; x < 1024; x += step) {
-    ctx.beginPath();
-    ctx.moveTo(x, 512);
-    ctx.lineTo(x + 512, 0);
-    ctx.stroke();
-  }
-
-  // Micro perforation dots
-  ctx.fillStyle = '#020204';
-  for (let x = 0; x < 512; x += step) {
-    for (let y = 0; y < 512; y += step) {
-      ctx.beginPath();
-      ctx.arc(x + step / 2, y + step / 2, 2.5, 0, Math.PI * 2);
-      ctx.fill();
-    }
-  }
-
-  const texture = new THREE.CanvasTexture(canvas);
-  texture.wrapS = THREE.RepeatWrapping;
-  texture.wrapT = THREE.RepeatWrapping;
-  texture.repeat.set(6, 6);
-  return texture;
-};
-
-// Procedural Bump Map for 3D tactile grille net depth
-const createMicBumpTexture = () => {
-  const canvas = document.createElement('canvas');
-  canvas.width = 256;
-  canvas.height = 256;
-  const ctx = canvas.getContext('2d');
-
-  ctx.fillStyle = '#808080';
-  ctx.fillRect(0, 0, 256, 256);
-
-  ctx.lineWidth = 3;
-  const step = 16;
-  ctx.strokeStyle = '#ffffff';
-
-  for (let x = -256; x < 512; x += step) {
-    ctx.beginPath();
-    ctx.moveTo(x, 0);
-    ctx.lineTo(x + 256, 256);
-    ctx.stroke();
-
-    ctx.beginPath();
-    ctx.moveTo(x, 256);
-    ctx.lineTo(x + 256, 0);
-    ctx.stroke();
-  }
-
-  ctx.fillStyle = '#000000';
-  for (let x = 0; x < 256; x += step) {
-    for (let y = 0; y < 256; y += step) {
-      ctx.beginPath();
-      ctx.arc(x + step / 2, y + step / 2, 3.0, 0, Math.PI * 2);
-      ctx.fill();
-    }
-  }
-
-  const bumpTex = new THREE.CanvasTexture(canvas);
-  bumpTex.wrapS = THREE.RepeatWrapping;
-  bumpTex.wrapT = THREE.RepeatWrapping;
-  bumpTex.repeat.set(6, 6);
-  return bumpTex;
-};
