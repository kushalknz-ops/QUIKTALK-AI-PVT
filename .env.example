# Quiktalk AI Environment Configuration Example
# Copy this file to .env for local testing if needed (never commit production secrets)

# Port for local server (defaults to 3000)
PORT=3000

# Webhook endpoint for lead dispatch (e.g. CRM, n8n, Slack webhook, or Zapier)
# Leave empty for local development (leads will be logged to console)
LEAD_WEBHOOK_URL=

# Notification recipient email address
ADMIN_EMAIL=admin@quiktalkai.com

# Analytics ID (GA4 Measurement ID, Plausible domain, or PostHog key)
# Gated behind cookie consent architecture
ANALYTICS_ID=

# Schema toggles (default false during draft quarantine)
ENABLE_SCHEMA_PRICING=false
ENABLE_SCHEMA_REVIEWS=false
